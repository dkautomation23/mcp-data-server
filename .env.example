# Copy to .env and adjust. The real .env is git-ignored.

# SQLite file to expose. Always opened read-only, whatever this points at.
DATABASE_PATH=demo.db

# Tables the model may read. Empty = every table in the file.
# Anything not listed is invisible: not described, not queryable, not joinable.
ALLOWED_TABLES=customers,orders,order_items

# Columns replaced with "***" in every result (table.column, comma separated).
MASKED_COLUMNS=customers.email,customers.phone

# Hard cap on rows returned per call - protects the model's context and the DB.
MAX_ROWS=200

# A query running longer than this is cancelled.
QUERY_TIMEOUT_SECONDS=10

# Every executed statement is appended here. Empty string disables auditing.
AUDIT_LOG_PATH=audit.log
